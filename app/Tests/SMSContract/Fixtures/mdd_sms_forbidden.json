    "forbidden_paths": [
      "/api/instances/{id}/sms",
      "/api/instances/{id}/sms/send",
      "/api/instances/{id}/messages"
    ],
    "required_paths": [
      "/api/sms/contacts",
      "/api/sms/thread",
      "/api/sms/send"
    ]
  }
}
